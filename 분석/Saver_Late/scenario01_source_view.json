    {
      "name": "01.dee",
      "path": "분석/Saver_Late/decoded/map/01set.arc/01.dee",
      "role": "종료 연출 대본. 전투 초기 배치와 구별.",
      "originalSha256": "24c09da92b0e5a8345e368e0ebb3489889504ce6d981dd8fe7a4b7f38119fd55",
      "lines": [
        {
          "line": 1,
          "text": "LOADSCENE 01"
        },
        {
          "line": 2,
          "text": "SETPOSITION 20 8"
        },
        {
          "line": 3,
          "text": "CHARPOS 801 801 19 6"
        },
        {
          "line": 4,
